# Neon Postgres (pooled connection, used at runtime)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# Neon Postgres (direct/unpooled connection, required by Prisma Migrate)
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# Composio
COMPOSIO_API_KEY="your-composio-api-key"
CONNECTED_ACCOUNT_ID="your-gmail-connected-account-id"

# Session
SESSION_SECRET="32-byte-random-string-generate-with-openssl-rand-base64-32"

# Seed script (only read at `npx prisma db seed` time, never committed)
SEED_ARYAN_EMAIL="aryan@mehtadoshi.example"
SEED_ARYAN_PASSWORD="choose-a-real-password"
SEED_SAMEER_EMAIL="sameer@mehtadoshi.example"
SEED_SAMEER_PASSWORD="choose-a-real-password"
