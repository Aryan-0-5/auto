# Neon Postgres (pooled connection, used at runtime)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# Neon Postgres (direct/unpooled connection, required by Prisma Migrate)
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# Composio
COMPOSIO_API_KEY="your-composio-api-key"
# The connected account's `id` field (e.g. "ca_xxxxxxxx") from GET
# /api/v3/connected_accounts — NOT the human-readable `word_id` alias.
CONNECTED_ACCOUNT_ID="ca_your-connected-account-id"
# The connected account's `user_id` field from that same response. Required on
# every tool call — omitting it 400s with ActionExecute_ConnectedAccountEntityIdRequired.
COMPOSIO_ENTITY_ID="your-connected-account-user-id"

# Session
SESSION_SECRET="32-byte-random-string-generate-with-openssl-rand-base64-32"

# Seed script (only read at `npx prisma db seed` time, never committed).
# Shared PIN everyone enters to get past the lock screen — profiles (who's
# using it) are chosen separately afterward, self-service, no env var needed.
SHARED_PIN="choose-a-real-pin"
